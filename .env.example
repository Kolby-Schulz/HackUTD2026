# Copy to .env and fill in. Never commit .env — this repo is public.

# Model provider for packages/llm: claude-code (now) | nemotron (after demo-ready)
LLM_PROVIDER=claude-code

# claude-code: runs the local `claude` CLI headless with this machine's login (no key).
CLAUDE_BIN=claude
WORKER_MODEL=claude-sonnet-5-5
COORDINATOR_MODEL=claude-opus-5-5

# nemotron (later). Confirm slugs on build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# WORKER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# COORDINATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Jev triage (stretch, spec section 12b). Everything must work with TRIAGE=off.
TRIAGE=off
JEV_API_KEY=
TRIAGE_RESOLVE_P=0.90
TRIAGE_BEHAVIOR_P=0.80
TRIAGE_DUPLICATE_P=0.85
TRIAGE_PLAN_CLASH_P=0.85

# Local server (dev and tests). For the shared two-laptop demo database on maincloud, use:
#   SPACETIME_HOST=wss://maincloud.spacetimedb.com
#   SPACETIME_DB_NAME=contract-hackutd26
SPACETIME_HOST=ws://localhost:3000
SPACETIME_DB_NAME=contract

# Bring your own repo (issue #18). Unset = the built-in demo-repo/. A local path (a whole
# git repo or a folder inside one) or a git URL (cloned into .contract/repos/). Same as
# passing --repo to the worker, session, reset and mapper.
# CONTRACT_TARGET=../my-app
# Checks the merge runs, if the target has no contract.json "checks" (default: npm test).
# CONTRACT_TEST_CMD=npm test
