# Copy to .env and fill in. Never commit .env — this repo is public.

# Which model backend packages/llm uses: claude-code (default, for now) | nemotron
LLM_BACKEND=claude-code

# claude-code backend: runs the local `claude` CLI headless with this machine's login.
# No API key needed; run `claude` once interactively to log in.
CLAUDE_BIN=claude
WORKER_MODEL=claude-sonnet-5-5
COORDINATOR_MODEL=claude-opus-5-5

# nemotron backend (not implemented yet). Confirm slugs on build.nvidia.com.
NVIDIA_API_KEY=nvapi-xxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# WORKER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# COORDINATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b

SPACETIME_HOST=ws://localhost:3000
SPACETIME_DB_NAME=contract
