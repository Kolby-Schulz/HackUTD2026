# Copy to .env and fill in. Never commit .env — this repo is public.

# Model provider for packages/llm: claude-code | nemotron (decide() only; Nemotron workers are phase 2)
LLM_PROVIDER=claude-code
# The coordinator's provider, independent of the workers' LLM_PROVIDER. Unset = LLM_PROVIDER.
# Set to nemotron once NVIDIA_API_KEY below is filled in.
# COORDINATOR_PROVIDER=nemotron

# claude-code: runs the local `claude` CLI headless with this machine's login (no key).
CLAUDE_BIN=claude
WORKER_MODEL=claude-sonnet-5-5
COORDINATOR_MODEL=claude-opus-5-5

# nemotron: key from build.nvidia.com (one key works for every model; each teammate gets their own).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Lightning: ~1 s per decision. Ultra (nvidia/nemotron-3-ultra-550b-a55b): ~2 s. Both 12/12 on the planted conflicts.
NVIDIA_COORDINATOR_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_WORKER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Thinking off by default: on is 10-50x slower and was no more accurate in our tests.
# NVIDIA_THINKING=on
# NVIDIA_MAX_TOKENS=2048
# USD per million tokens for the cost column (hackathon tier is free).
# NVIDIA_PRICE_IN_PER_M=0
# NVIDIA_PRICE_OUT_PER_M=0
# Hosted coordinator: its SpacetimeDB token, so a redeploy keeps the same identity.
# COORDINATOR_TOKEN=

# Jev triage (stretch, spec section 12b). Everything must work with TRIAGE=off.
TRIAGE=off
JEV_API_KEY=
TRIAGE_RESOLVE_P=0.90
TRIAGE_BEHAVIOR_P=0.80
TRIAGE_DUPLICATE_P=0.85
TRIAGE_PLAN_CLASH_P=0.85

# Local server (dev and tests). For the shared two-laptop demo database on maincloud, use:
#   SPACETIME_HOST=wss://maincloud.spacetimedb.com
#   SPACETIME_DB_NAME=contract-hackutd26
SPACETIME_HOST=ws://localhost:3000
SPACETIME_DB_NAME=contract

# Bring your own repo (issue #18). Unset = the built-in demo-repo/. A local path (a whole
# git repo or a folder inside one) or a git URL (cloned into .contract/repos/). Same as
# passing --repo to the worker, session, reset and mapper.
# CONTRACT_TARGET=../my-app
# Checks the merge runs, if the target has no contract.json "checks" (default: npm test).
# CONTRACT_TEST_CMD=npm test
