{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dashboard"
      ],
      "port": 5173
    },
    {
      "name": "dashboard-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SPACETIME_HOST=ws://localhost:3000",
        "SPACETIME_DB_NAME=contract",
        "npm",
        "run",
        "dev",
        "-w",
        "@contract/dashboard",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "dashboard-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4174",
        "--strictPort"
      ],
      "cwd": "dashboard",
      "port": 4174
    },
    {
      "name": "control",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "control"
      ],
      "port": 5199
    },
    {
      "name": "dashboard-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@contract/dashboard",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "dashboard-daemon-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SPACETIME_HOST=ws://localhost:3000",
        "SPACETIME_DB_NAME=contract-daemon-test",
        "npm",
        "run",
        "dev",
        "-w",
        "@contract/dashboard",
        "--",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    },
    {
      "name": "dashboard-self",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SPACETIME_HOST=ws://localhost:3000",
        "SPACETIME_DB_NAME=contract-self",
        "npm",
        "run",
        "dev",
        "-w",
        "@contract/dashboard",
        "--",
        "--port",
        "5177",
        "--strictPort"
      ],
      "port": 5177
    }
  ]
