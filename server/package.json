{
  "name": "@contract/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rules": "./src/rules.ts"
  },
  "scripts": {
    "postinstall": "node scripts/link-tsc.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "spacetime build --module-path .",
    "publish": "spacetime publish --module-path . --server local contract",
    "publish:cloud": "spacetime publish --module-path . --server maincloud contract-hackutd26",
    "generate": "spacetime generate --lang typescript --out-dir ../packages/client/src/bindings --module-path . --yes",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "spacetimedb": "^2.14.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
